{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "base_revision": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "purpose": {
      "enum": [
        "aesthetic",
        "technical",
        "handoff"
      ]
    },
    "decision": {
      "enum": [
        "approve",
        "reject"
      ]
    }
  },
  "required": [
    "revision_id",
    "base_revision",
    "content_hash",
    "purpose",
    "decision"
  ],
  "additionalProperties": false
}
