{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "causation_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "enum": [
        "canvas.patch.proposed",
        "design.revision.created",
        "approval.decided"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "organization_id",
    "aggregate_id",
    "revision_id",
    "schema_version",
    "causation_id",
    "occurred_at",
    "event_type",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
